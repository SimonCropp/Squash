<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces src/nuget.config in the daily leg of linker-canary.yml, and only there. Daily builds of
  the linker are not on nuget.org and do not carry the signature src/nuget.config requires.

  The daily feed is named after the major version dotnet/runtime's main branch is building, so its
  name moves once a year. The workflow reads the address from here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="daily" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet12/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Central package management refuses a second source without a mapping. Only the linker comes
       from the daily feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="daily">
      <package pattern="Microsoft.NET.ILLink.Tasks" />
    </packageSource>
  </packageSourceMapping>
</configuration>
