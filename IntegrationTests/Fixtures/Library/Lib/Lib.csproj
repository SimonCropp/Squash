<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Squash" Version="$(Squash_Version)" PrivateAssets="all" />
  </ItemGroup>
  <!-- Each switched on by the test that needs it. -->
  <ItemGroup>
    <Compile Remove="Reflective.cs" Condition="'$(Reflective)' != 'true'" />
    <Squash_RootDescriptor Include="roots.xml" Condition="'$(Roots)' == 'true'" />
    <Squash_RootDescriptor Include="missing.xml" Condition="'$(BreakDescriptor)' == 'true'" />
  </ItemGroup>
</Project>
