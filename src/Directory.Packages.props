<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DiffEngine" Version="20.9.0" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="29.0.0" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.12.2" />
    <PackageVersion Include="Microsoft.ILVerification" Version="11.0.0" />
    <!-- The bundled linker. Its major must equal ILLinkMajor in Directory.Build.props. -->
    <PackageVersion Include="Microsoft.NET.ILLink.Tasks" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Polyfill" Version="12.0.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.191" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="Verify" Version="33.4.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.4.0" />
  </ItemGroup>
  <!-- The canary workflow tests a linker that has not shipped yet. -->
  <ItemGroup Condition="'$(Squash_CanaryILLinkVersion)' != ''">
    <PackageVersion Update="Microsoft.NET.ILLink.Tasks" Version="$(Squash_CanaryILLinkVersion)" />
  </ItemGroup>
</Project>