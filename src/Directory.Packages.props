<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DiffEngine" Version="20.8.1" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.5.1" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" Pinned="true" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.9.6" Pinned="true" />
    <PackageVersion Include="Microsoft.ILVerification" Version="10.0.13" />
    <!-- The bundled linker. Its major must equal ILLinkMajor in Directory.Build.props. -->
    <PackageVersion Include="Microsoft.NET.ILLink.Tasks" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.184" />
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="Verify" Version="33.3.3" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.3" />
  </ItemGroup>
  <!-- The canary workflow tests a linker that has not shipped yet. -->
  <ItemGroup Condition="'$(Squash_CanaryILLinkVersion)' != ''">
    <PackageVersion Update="Microsoft.NET.ILLink.Tasks" Version="$(Squash_CanaryILLinkVersion)" />
  </ItemGroup>
</Project>