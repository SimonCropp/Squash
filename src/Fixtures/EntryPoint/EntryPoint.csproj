<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- An executable whose entry point is private, as a top-level program's always is. Rooting the
         public surface alone would trim it away. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DebugType>portable</DebugType>
  </PropertyGroup>
</Project>
